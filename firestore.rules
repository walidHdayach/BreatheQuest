rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: only the authenticated user can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // User sessions: only the owner can read/write
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Optional: weekly stats
    match /users/{userId}/weeklyStats/{weekId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Content/tips: anyone authenticated can read; only admins could write (not implemented here)
    match /content/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /content/tips/items/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
